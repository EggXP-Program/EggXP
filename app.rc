#include <windows.h>
1 RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "EggXP - Egg, Inc. mission history fetcher"
      VALUE "FileVersion", "1.0.1.0"
      VALUE "ProductName", "EggXP"
      VALUE "ProductVersion", "1.0.1"
      VALUE "OriginalFilename", "EggXP.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
